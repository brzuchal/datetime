{
  "name": "brzuchal/datetime",
  "description": "A library for parsing and reading Time Zone Information Format (TZif) files.",
  "license": "MIT",
  "authors": [
    {
      "name": "Micha\u0142 Marcin Brzuchalski",
      "email": "michal.brzuchalski@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Brzuchal\\DateTime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-gmp": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "brzuchal/coding-standard": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/brzuchal/coding-standard"
    }
  ]
}
