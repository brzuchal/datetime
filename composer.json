{
  "name": "brzuchal/datetime",
  "description": "A library for parsing and reading Time Zone Information Format (TZif) files.",
  "license": "MIT",
  "authors": [
    {
      "name": "Michał Marcin Brzuchalski",
      "email": "michal.brzuchalski@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Brzuchal\\DateTime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-gmp": ">=8.4"
  },
  "require-dev": {
    "doctrine/coding-standard": "^12.0",
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
